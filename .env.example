# ==========================================
# Student Grids System - Environment Template
# ==========================================

# --- Core Django Settings ---
# Generate a new cryptographic key for production
SECRET_KEY=your_secure_django_secret_key_here

# Must be False in production
DEBUG=False

# Comma-separated list of allowed domains (e.g., studentgrids.uwi.edu)
ALLOWED_HOSTS=localhost,127.0.0.1,.herokuapp.com

# --- Database Configuration ---
# Standard PostgreSQL connection string format
DATABASE_URL=postgres://db_user:db_password@localhost:5432/student_grids_db

# --- Email Pipeline (Resend) ---
# Create an account at Resend.com, verify your sending domain, and generate an API key
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# The verified subdomain used for transactional emails
DEFAULT_FROM_EMAIL=admin@notify.yourdomain.edu